PAYMENT_HOST=0.0.0.0
PAYMENT_PORT=3134
PAYMENT_BASE_URL=http://localhost:3134
# Public URL for gateway webhooks (M-Pesa STK CallBackURL). Use when API is local but callbacks need a reachable host.
# Example: https://your-domain.com or http://192.168.1.10:3134
# Left blank on purpose: no third-party demo host is shipped with this repo. When unset/blank the
# service falls back to PAYMENT_BASE_URL above (payments/src/lib/intent.utils.js:28-32).
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_LOG_LEVEL=debug

# Comma separated allow-list for incoming frontend origins.
PAYMENT_ALLOWED_ORIGINS=http://localhost:5173

# Gateway credentials (server-side only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGERITY_SALT=
JAZZCASH_WEBHOOK_SECRET=

# SurrealDB (M-Pesa gateway config lookup per payment type)
# Use ws://surrealdb:8001/rpc when running inside docker-compose.
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_CONNECT_TIMEOUT_MS=10000
SURREAL_NS=posr
SURREAL_DB=posr
# LOCAL DEV ONLY — must match SurrealDB and root .env.
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me

# Same GATEWAY_JWT_SECRET as root .env. LOCAL DEV ONLY.
# No shared default is committed: generate one per machine with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATEWAY_JWT_SECRET=
GATEWAY_AUTH_REQUIRED=true

# AES-256-GCM key for payment gateway credentials at rest (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to INTEGRATION_TOKEN_ENCRYPTION_KEY when unset. Required in production.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
