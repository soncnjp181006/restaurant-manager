# Tracking ingestion API configuration.
# Copy this file to `.env` inside `tracking-api/`. All secrets stay server-side.

TRACKING_HOST=0.0.0.0
TRACKING_PORT=3138

# Comma separated allow-list for incoming frontend origins.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

# Session JWT (same secret as the gateway and the other sidecars).
# MUST be regenerated for every deployment. Do NOT reuse a value from git.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATEWAY_JWT_SECRET=
# Sidecar routes require Authorization: Bearer <pos_session>. Set false only
# for emergency rollback (see docs/security/GATEWAY.md).
GATEWAY_AUTH_REQUIRED=false

# Authoritative store — every report reads `tracking` from here (dbproxy RPC).
TRACKING_DB_URL=ws://dbproxy:8000/rpc
TRACKING_DB_NS=restaurant_manager
TRACKING_DB_NAME=restaurant_manager
# Required, no default: the service refuses to start rather than fall back to
# root/root. Set them to the same credentials as SURREAL_USER/SURREAL_PASS.
TRACKING_DB_USER=
TRACKING_DB_PASS=

# ---------------------------------------------------------------------------
# Optional MySQL analytical mirror (see docker-compose.analytics.yml).
#
# The store above (dbproxy -> MySQL `records`) stays what the app reads; this
# only copies each ingested event into a flat tracking_events table for
# SQL-native analytics. Leave every variable below unset (or blank) and the
# mirror is completely inert — no new connection, no behaviour change. A mirror
# failure never fails ingestion; it shows up on GET /health as
# mysqlMirrorFailures.
# ---------------------------------------------------------------------------

# Either a full mysql:// URL (host, port and database all inside it)...
TRACKING_MYSQL_URL=
# ...or the discrete parts (used when TRACKING_MYSQL_URL is blank).
TRACKING_MYSQL_HOST=
TRACKING_MYSQL_PORT=3306
TRACKING_MYSQL_DB=tracking
TRACKING_MYSQL_USER=
TRACKING_MYSQL_PASS=
# There is no TRACKING_MYSQL_SCHEMA: MySQL has no search_path, so the database
# the mirror table lives in is TRACKING_MYSQL_DB (or the URL path).
