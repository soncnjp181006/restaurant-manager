  closed_at datetime(3)
  closed_by varchar(512) [ref: > user.id]
  created_at datetime(3)
  created_by varchar(512) [ref: > user.id]
  expected_guests bigint
  location varchar(512) [ref: > inventory_location.id]
  menu varchar(512) [ref: > buffet_menu.id]
  notes text
  posted_to_ledger tinyint(1)
  scheduled_end datetime(3)
  scheduled_start datetime(3)
  session_number text
  session_type varchar(255)
  started_at datetime(3)
  status text
  store varchar(512) [ref: > inventory_store.id]
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table buffet_stock_snapshot {
  id varchar(512) [pk]
  captured_at datetime(3)
  captured_by varchar(512) [ref: > user.id]
  item varchar(512) [ref: > inventory_item.id]
  notes text
  production_batch varchar(512) [ref: > production_batch.id]
  quantity double
  session varchar(512) [ref: > buffet_session.id]
  snapshot_type varchar(255)
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table buffet_waste_log {
  id varchar(512) [pk]
  created_at datetime(3)
  created_by varchar(512) [ref: > user.id]
  item varchar(512) [ref: > inventory_item.id]
  ledger_waste_item varchar(512) [ref: > inventory_item_waste_item.id]
  quantity double
