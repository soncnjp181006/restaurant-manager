Table _schema_migration {
  id varchar(512) [pk]
  applied_at datetime(3)
  name varchar(255)
  note text
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table account {
  id varchar(512) [pk]
  account_type text
  code varchar(255)
  created_at datetime(3)
  group varchar(512) [ref: > account_group.id]
  is_active tinyint(1)
  name text
  normal_balance text
  notes text
  parent varchar(512) [ref: > account.id]
  updated_at datetime(3)
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table account_group {
  id varchar(512) [pk]
  code varchar(255)
  created_at datetime(3)
  head_type text
  is_active tinyint(1)
  name text
  normal_balance text
  notes text
  updated_at datetime(3)
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table account_journal_entry {
  id varchar(512) [pk]
  created_at datetime(3)
  created_by varchar(512) [ref: > user.id]
  date datetime(3)
  entry_number bigint
  generated_at datetime(3)
  generated_by text
  idempotency_key varchar(255)
  integration_provider_id text
  journal_template_id text
  memo text
  origin_event text
  origin_module text
  origin_record_id text
  posting_rule_id text
  source_id text
  source_module text
  status varchar(255)
  updated_at datetime(3)
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table account_journal_entry__documents {
  parent_id varchar(512) [pk, ref: > account_journal_entry.id]
  ord int [pk]
  ref_id varchar(512) [ref: > document.id]
}

Table account_journal_entry__lines {
  parent_id varchar(512) [pk, ref: > account_journal_entry.id]
  ord int [pk]
  ref_id varchar(512) [ref: > account_journal_line.id]
}

Table account_journal_line {
  id varchar(512) [pk]
  account varchar(512) [ref: > account.id]
  created_at datetime(3)
  credit double
  debit double
  description text
  entry varchar(512) [ref: > account_journal_entry.id]
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table audit_log {
  id varchar(512) [pk]
  action varchar(64)
  actor_id varchar(64)
  actor_login text
  occurred_at datetime(3)
  record_id varchar(255)
  source text
  table_name varchar(255)
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table audit_log__actor_roles {
  parent_id varchar(512) [pk, ref: > audit_log.id]
  ord int [pk]
  value_text varchar(512)
}

Table audit_log__changed_fields {
  parent_id varchar(512) [pk, ref: > audit_log.id]
  ord int [pk]
  value_text varchar(512)
}

Table auth_permission {
  id varchar(512) [pk]
  row_created_at timestamp(3) [not null]
  row_updated_at timestamp(3) [not null]
}

Table buffet_consumption_log {
  id varchar(512) [pk]
  guest_consumption double
  item varchar(512) [ref: > inventory_item.id]
